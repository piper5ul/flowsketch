datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// BetterAuth-managed tables
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  diagrams Diagram[]
  images   Image[]
  /// This user's own folders. Personal filing, not shared: a folder never
  /// travels with a diagram to the people it is shared with.
  folders  Folder[]
  /// Diagrams owned by *someone else* that this user has been invited to.
  memberships DiagramMember[]
  /// Version snapshots this user's edits produced. Kept (with a null author)
  /// when the account goes away, because they belong to someone else's diagram.
  versions DiagramVersion[]
  /// Comment threads this user started, and the individual comments they wrote.
  /// Both cascade with the account: a comment is a person speaking, and an
  /// authorless one on someone else's board is worse than none at all.
  commentThreads CommentThread[]
  comments       Comment[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Application tables
// ---------------------------------------------------------------------------

/// One of the owner's folders — a single flat level of personal filing.
///
/// A folder belongs to a *person*, not to a diagram's access list: `userId` is
/// its owner and the only account that can see it, and `Diagram.folderId` is
/// therefore only ever meaningful to that diagram's owner. Somebody invited to
/// a diagram files it nowhere; their dashboard shows it under "Shared with me"
/// however the owner has filed it. That is why there is no `(diagramId, userId)`
/// join table here: per-viewer filing of somebody else's board is a different
/// feature, and this one is deliberately the smaller half.
///
/// Names are not unique. Two folders called "Clients" is a mess the user made
/// and can undo by renaming one; a database that refuses the second one is a
/// dashboard that has to explain itself mid-typing.
model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagrams Diagram[]

  /// The listing is always "my folders".
  @@index([userId])
}

model Diagram {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled")
  data      Json
  thumbnail String?
  starred   Boolean  @default(false)
  /// The owner's folder this is filed in, or `null` for the root of their
  /// dashboard. `SetNull` on delete, so removing a folder unfiles its diagrams
  /// rather than taking them with it — a folder is a label, and deleting a
  /// label must never delete the work.
  folderId  String?
  /// Public read-only link token. `null` means the diagram is not shared;
  /// a value makes it readable at `/s/<token>` with no session at all, so it
  /// is unguessable (24 bytes of `crypto.randomBytes`) rather than derived
  /// from the id.
  shareToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  members  DiagramMember[]
  versions DiagramVersion[]
  threads  CommentThread[]
  images   DiagramImage[]
  /// The live collaborative document, once this diagram has been opened by a
  /// client that speaks it. Optional: a diagram that predates realtime — or one
  /// nobody has opened since — has none, and `data` is the whole of it.
  doc      DiagramDoc?

  @@index([userId, updatedAt(sort: Desc)])
  /// Counting each folder's diagrams, and (once there are enough of them)
  /// listing one folder's.
  @@index([folderId])
}

/// The Yjs document behind a diagram — the source of truth for its contents
/// once anybody has opened it collaboratively.
///
/// `state` is `Y.encodeStateAsUpdate(doc)`: the whole document as one binary
/// update, which is what Yjs merges rather than a log this server has to
/// replay. Hocuspocus writes it on a debounce while people are editing, and
/// `Diagram.data` is re-rendered from it in the same write — JSON stays the
/// *output* everything else reads (the dashboard, exports, versions, the public
/// page, the image index), and this is the input.
///
/// A row appears the first time a diagram is opened over the collaboration
/// socket: `fetch` seeds the document from `Diagram.data` when there is nothing
/// here yet (the **lazy upgrade** — nothing is migrated in bulk). Its presence
/// is therefore also the answer to "is this diagram collaborative?", which is
/// what lets `PUT /api/diagrams/:id` keep accepting a whole-copy `data` write
/// for a diagram that has never had one and refuse it for one that has.
///
/// Cascades from the diagram: a deleted diagram has no document.
model DiagramDoc {
  diagramId String   @id
  state     Bytes
  updatedAt DateTime @updatedAt

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
}

/// Which uploaded images a diagram's *current* JSON draws — the index behind
/// every question of the form "does anything still point at this image?".
///
/// The reference itself lives inside `Diagram.data`, where Postgres cannot
/// index it, so answering that question used to mean reading the JSON of every
/// diagram in scope: once to decide whether a member may fetch an image, once
/// for a share token, once per garbage-collection pass. A row here per
/// (diagram, image) pair turns all three into an indexed lookup.
///
/// It indexes **live diagrams only**. `DiagramVersion` snapshots also keep an
/// image alive, and those are still found by scanning — a scan that only runs
/// for an image already up for collection, which is rare, where the read paths
/// above run on every request.
///
/// Rows are written by `syncDiagramImages` on every write that changes `data`
/// and are cascaded away with either side, so the table never outlives what it
/// describes. An existing database is backfilled once by
/// `scripts/reindex-images.ts` (see DEPLOYMENT.md).
model DiagramImage {
  diagramId String
  imageId   String

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([diagramId, imageId])
  @@index([imageId])
}

/// A conversation pinned to a diagram — one thread, one or more comments.
///
/// A thread is anchored either to a shape (`nodeId`, the node's id inside
/// `Diagram.data`) or to a bare canvas position (`x`+`y`); exactly one of the
/// two is set, which the API enforces because there is no database constraint
/// that can express it across three nullable columns. `nodeId` is a plain
/// String and *not* a foreign key: nodes live inside a JSON column, so a thread
/// can outlive the shape it was pinned to — the canvas decides whether to draw
/// an orphaned pin or park it, and nothing here deletes the conversation.
///
/// A thread always has at least one comment (the one that created it). Deleting
/// the last comment deletes the thread, so an empty thread is never stored.
model CommentThread {
  id          String   @id @default(cuid())
  diagramId   String
  /// The shape this thread is pinned to, or `null` for a canvas-position one.
  nodeId      String?
  /// Diagram coordinates, set only on a thread that is not anchored to a shape.
  x           Float?
  y           Float?
  resolved    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  diagram   Diagram   @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  comments  Comment[]

  /// The listing is "this diagram's open threads" or "…its resolved ones".
  @@index([diagramId, resolved])
  @@index([createdById])
}

/// One message in a `CommentThread`, oldest first as the thread reads.
///
/// `editedAt` is `null` until the author changes the text, which is what lets
/// the UI mark a comment as edited without keeping a revision history: a
/// comment is a remark, not a document, so the previous wording is not kept.
model Comment {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  /// Set the first time the author rewrites the body; `null` on an untouched one.
  editedAt  DateTime?

  thread CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

/// A point-in-time copy of a diagram's `data` and `title`.
///
/// Rows are written by `server/versions.ts`: automatically by a `PUT` that
/// changes `data` (at most one per `VERSION_INTERVAL_MS`, holding the state
/// *before* that edit burst), and on demand by the manual-snapshot and restore
/// routes. Only the newest `MAX_VERSIONS` per diagram are kept.
///
/// `data` is a full copy rather than a diff: a diagram is a bounded JSON
/// document (5 MB at the API's body limit), and a snapshot that can be restored
/// without replaying a chain is worth far more than the bytes it saves.
model DiagramVersion {
  id        String   @id @default(cuid())
  diagramId String
  data      Json
  /// The title as it stood in this version, so a restore puts back the name
  /// the diagram had as well as its contents.
  title     String
  createdAt DateTime @default(now())
  /// Who caused the snapshot. Nullable: the author's account may be deleted
  /// while the (someone else's) diagram this version belongs to lives on.
  createdById String?
  /// Set on a manual snapshot ("Before restore", or whatever the user typed);
  /// `null` on an automatic one.
  label     String?

  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([diagramId, createdAt(sort: Desc)])
  @@index([createdById])
}

/// A user who has been invited to a diagram they do not own.
///
/// The owner is *not* a row here — ownership is `Diagram.userId` — so a
/// diagram's full access list is its owner plus these rows. `role` is one of
/// `DiagramRole` from `shared/types.ts` ('editor' | 'viewer'); it is a String
/// rather than an enum so adding a role is a code change, not a migration that
/// has to be applied before the code that writes it.
model DiagramMember {
  id        String   @id @default(cuid())
  diagramId String
  userId    String
  role      String
  createdAt DateTime @default(now())

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([diagramId, userId])
  @@index([userId])
}

/// Metadata for an uploaded image. The bytes live on disk under
/// `UPLOAD_DIR/<userId>/<id>.<ext>`; the extension is derived from `mime`.
model Image {
  id        String   @id @default(cuid())
  userId    String
  mime      String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagrams DiagramImage[]

  @@index([userId])
}
