DATABASE_URL=postgresql://postgres@localhost:5432/flowsketch
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:5199
# Hostnames the site used to answer on, comma-separated. A request for one is
# redirected (301, path and query kept) to BETTER_AUTH_URL.
# LEGACY_HOSTS=old.example.com
SMTP_HOST=localhost
SMTP_PORT=1025
PORT=3001

# Where uploaded images are written. Relative paths resolve from the working directory.
UPLOAD_DIR=./uploads

# Set to anything to log real-time collaboration connects and disconnects. Off
# by default: one line per page view per document, and none of it actionable —
# a refused connection throws instead, which is the part worth seeing.
# COLLAB_DEBUG=1

# Version history. A save that changes the diagram snapshots the previous state,
# at most once per VERSION_INTERVAL_MS; the newest MAX_VERSIONS are kept per
# diagram. Both fall back to the defaults below if set to anything else.
VERSION_INTERVAL_MS=600000
MAX_VERSIONS=50
