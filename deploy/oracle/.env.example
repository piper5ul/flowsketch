# Copy to deploy/oracle/.env on the VM. setup.sh fills the two secrets in for you.
POSTGRES_PASSWORD=
# The app's connection string to the `db` service, using that password: setup.sh writes it.
DATABASE_URL=
BETTER_AUTH_SECRET=
# The public address people will use, exactly as in the browser (scheme, no trailing slash).
PUBLIC_URL=https://demo.example.com
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=
